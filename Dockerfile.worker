# Worker image with ML extras (Kokoro / CLIP / Chroma) for the main YouTube path.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NUMBA_CACHE_DIR=/tmp/numba_cache \
    MPLCONFIGDIR=/tmp/matplotlib

RUN groupadd -r appuser && useradd -r -g appuser appuser

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    espeak-ng \
    libsndfile1 \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --chown=appuser:appuser pyproject.toml README.md ./
COPY --chown=appuser:appuser src ./src
COPY --chown=appuser:appuser alembic ./alembic
COPY --chown=appuser:appuser alembic.ini ./
COPY --chown=appuser:appuser config ./config

RUN pip install --upgrade pip && pip install -e ".[ml]"

RUN mkdir -p /data/chroma /tmp/work /tmp/numba_cache /tmp/matplotlib \
    && chown -R appuser:appuser /data /tmp/work /tmp/numba_cache /tmp/matplotlib /app

USER appuser

CMD ["arq", "src.workers.settings.WorkerSettings"]
