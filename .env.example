# Application
APP_ENV=development
APP_NAME=youtube-automation-engine
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_USER=youtube
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=youtube_automation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://youtube:change_me_strong_password@localhost:5432/youtube_automation

# Redis / ARQ
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_BUCKET=youtube-artifacts
S3_REGION=us-east-1

# LLM (OpenAI-compatible: WaveSpeed or OpenRouter)
WAVESPEED_API_KEY=
LLM_BASE_URL=https://llm.wavespeed.ai/v1
LLM_MODEL=google/gemini-2.5-flash

# Kokoro TTS
KOKORO_VOICE=am_michael
KOKORO_LANG=a
CHROMA_PERSIST_DIR=/data/chroma

# YouTube OAuth (refresh-token flow — headless)
YOUTUBE_CLIENT_SECRETS_FILE=/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/secrets/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
RUNPOD_API_KEY=your_runpod_api_key_here
AIRTABLE_API_KEY=your_airtable_pat_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
APIFY_TOKEN=your_apify_token_here
RUNPOD_ENDPOINT_ID=
RUNPOD_ENABLED=false

# Alerts (pager-only, not primary monitoring)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1533472970348036207/ltF5iUhAD8uh8Uy7EzVuxp6k6CLIaFWeVhZ3uQG4XUmjrE-OdnYwjZtn-a_26C8P6oDK

# Security
SECRET_ENCRYPTION_KEY=change_me_32_byte_url_safe_base64_key
MAX_JOB_ATTEMPTS=3
