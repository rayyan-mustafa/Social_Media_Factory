# Application
APP_ENV=development
APP_NAME=youtube-automation-engine
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Optional: set to enable X-API-Key auth on /v1/*
API_KEY=

# PostgreSQL
POSTGRES_USER=youtube
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=youtube_automation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://youtube:change_me_strong_password@localhost:5432/youtube_automation

# Redis / ARQ
REDIS_URL=redis://localhost:6379/0
MAIN_QUEUE_NAME=YouTube_Shorts

# MinIO (S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_BUCKET=youtube-artifacts
S3_REGION=us-east-1

# LLM (OpenAI-compatible: WaveSpeed or OpenRouter)
WAVESPEED_API_KEY=
LLM_BASE_URL=https://llm.wavespeed.ai/v1
LLM_MODEL=google/gemini-2.5-flash

# Kokoro TTS
KOKORO_VOICE=am_michael
KOKORO_LANG=a
CHROMA_PERSIST_DIR=/data/chroma

# YouTube OAuth (refresh-token flow — headless)
YOUTUBE_CLIENT_SECRETS_FILE=/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/secrets/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private

# Optional growth tools (compose --profile growth)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
APIFY_TOKEN=

# RunPod (REQUIRED for VPS production — heavy video render)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_ENABLED=true

# Alerts / webhooks (placeholders only — never commit real URLs)
DISCORD_WEBHOOK_URL=
JOB_WEBHOOK_URL=

# Security
SECRET_ENCRYPTION_KEY=change_me_32_byte_url_safe_base64_key
MAX_JOB_ATTEMPTS=3

# === 24/7 VOD-loop livestream (CPU only; separate from GPU farm) ===
# Production = VPS vod_loop (systemd). StreamCast desktop GUI is NOT prod.
# Own public VODs / ambient only. Never fake a breaking-live event.
# Real stream keys belong in .env only — never commit them / never paste into chat.
# Rotate YT stream keys if they were ever exposed via StreamCast sessions.json.
VOD_LOOP_ENABLED=1
YT_LIVE_RTMP_URL_NAPSTORIAN=rtmp://a.rtmp.youtube.com/live2
YT_LIVE_RTMP_KEY_NAPSTORIAN=
YT_LIVE_RTMP_URL_NAPPING_HISTORIAN=rtmp://a.rtmp.youtube.com/live2
YT_LIVE_RTMP_KEY_NAPPING_HISTORIAN=
# Encode (YouTube H.264 ~720p30 / ~4 Mbps CBR-ish, 2s keyframes, AAC 128k)
# YT recs: 720p30~4Mbps · 1080p30~10Mbps · 1080p60~12Mbps
# Our default ~3800k @720p30 (raised from legacy 2500k). StreamCast docs ~3Mbps@720p.
# Adaptive ladder (default on): output/ops/stream_bitrate_policy.json
#   2500 → 3500 → 4000 → 4500; steps up after 3 healthy */10 checks
# VOD_LOOP_ADAPTIVE=1
# VOD_LOOP_ALLOW_1080=0
# VOD_LOOP_BITRATE_K=3800
# VOD_LOOP_BITRATE=3800          # alias for BITRATE_K (also accepts 3800k / 3.8M)
# VOD_LOOP_HEIGHT=720
# VOD_LOOP_FPS=30
# VOD_LOOP_AUDIO_BITRATE=128k
# VOD_LOOP_PRESET=veryfast
# VOD_LOOP_STALL_SEC=180
# VOD_LOOP_BACKOFF_BASE_SEC=5
# VOD_LOOP_BACKOFF_MAX_SEC=300
# Optional playlist overrides (ffmpeg concat demuxer files)
# VOD_LOOP_PLAYLIST_NAPSTORIAN=config/streaming/playlist_napstorian.txt
# VOD_LOOP_PLAYLIST_NAPPING_HISTORIAN=config/streaming/playlist_napping_historian.txt
# stream_beat */1 + vod_picker (own finals only; see output/ops/STREAM_STATUS.md)
# STREAM_BEAT_AUTO_PICK=1
# STREAM_BEAT_PICK_INTERVAL_SEC=1800
# STREAM_BEAT_SMM_WATCH=1
# STREAM_BEAT_SMM_INTERVAL_SEC=900
# VOD_PICKER_MIN_DURATION_SEC=180
# VOD_PICKER_LIMIT=8  # ranked Live playlist pool (head=featured; tails=swap candidates)
# Phase 2a multiplatform RTMP (empty = off). Cap encodes on this VPS — see VPS_UPGRADE_GATE.md
# VOD_LOOP_MAX_CONCURRENT_ENCODES=2
# TWITCH_RTMP_URL_NAPSTORIAN=
# TWITCH_RTMP_KEY_NAPSTORIAN=
# KICK_RTMP_URL_NAPSTORIAN=
# KICK_RTMP_KEY_NAPSTORIAN=
# FB_LIVE_RTMP_URL_NAPSTORIAN=
# FB_LIVE_RTMP_KEY_NAPSTORIAN=

# === Dual-channel YouTube upload OAuth (Brand Accounts) ===
# Shared Desktop client secrets (same GCP project OK for both Brand Accounts):
YOUTUBE_CLIENT_SECRETS_PATH=config/youtube_client_secrets.json
# napstorian keeps the legacy token path (do not wipe when adding channel 2):
YOUTUBE_TOKEN_PATH=config/youtube_token.json
# napping_historian gets its own token file:
YOUTUBE_TOKEN_PATH_NAPPING_HISTORIAN=config/youtube_token_napping_historian.json
# Shared description disclosure footer (napstorian + napping_historian):
# Visuals/narration AI-assisted; script is original and human-written.
YOUTUBE_AI_DISCLOSURE_TEXT=Visuals and narration in this video are AI-assisted. The script is original and human-written. Altered or synthetic media is disclosed per YouTube guidelines.
# Gate R retention checks are advisory by default (do not HOLD / block publish):
# GATE_R_ENFORCE=false
# See output/ops/GATE_R_ADVISORY.md
# Auth channel 2:
#   .venv/bin/python -m src.cli.youtube_auth --channel napping_historian --print-url
# See output/ops/YOUTUBE_DUAL_CHANNEL_AUTH.md

# ---------------------------------------------------------------------------
# Microstock vector engine (src/microstock/) — see src/microstock/README.md
# ---------------------------------------------------------------------------
# Nano Banana image generation. Key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Tagging uses OPENROUTER_API_KEY (free tier) by default — see above.

# FTP credentials for Tier A platforms. Host defaults come from
# config/microstock/platforms.json; only USER/PASS are normally needed.
# Never put these in platforms.json — that file is committed.
# MICROSTOCK_FTP_VECTEEZY_USER=
# MICROSTOCK_FTP_VECTEEZY_PASS=
# MICROSTOCK_FTP_DEPOSITPHOTOS_USER=
# MICROSTOCK_FTP_DEPOSITPHOTOS_PASS=
# MICROSTOCK_FTP_DREAMSTIME_USER=
# MICROSTOCK_FTP_DREAMSTIME_PASS=
# MICROSTOCK_FTP_123RF_USER=
# MICROSTOCK_FTP_123RF_PASS=
