cat > .gitignore << 'EOF'
# ===== Secrets & credentials =====
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
config/**/*client_secret*
config/**/*token*.json*
config/**/*service_account*.json
config/**/*credentials*.json
*.pem
*.key
*.bak

# ===== Generated output (folder structure kept via .gitkeep) =====
output/**
!output/**/
!output/**/.gitkeep

# ===== Logs & local state =====
*.log
logs/
*.db
*.sqlite
*.sqlite3

# ===== Client data =====
clients/*/chatbot.html
clients/*/config.json

# ===== Models / weights =====
models/**/*.onnx
models/**/*.bin
*.safetensors
*.ckpt
*.pth

# ===== Python =====
__pycache__/
*.py[cod]
.venv*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ===== Tools / OS / editors =====
.vercel/
.DS_Store
.idea/
.vscode/
*.swp
EOF
