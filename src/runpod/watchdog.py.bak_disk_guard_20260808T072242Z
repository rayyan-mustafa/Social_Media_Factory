                f"gpu_lock busy gpu={gpu_n} inflight={inflight} "
                f">= max_gpu={max_g}"
            )
        return False, f"gpu={gpu_n} inflight={inflight} max_gpu={max_g}"
    except Exception as exc:  # noqa: BLE001
        return True, f"concurrent check failed: {exc}"


