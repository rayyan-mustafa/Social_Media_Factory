    dry_run: bool,
    auto_starts_today: int = 0,
    soft_cap: int = 0,
    hard_cap: int = 0,
    smoke_ok: bool,
    smoke_msg: str,
    concurrent_busy: bool,
    concurrent_msg: str,
    budget_ok: bool,
    budget_msg: str,
    pending_ok: bool = True,
    pending_msg: str = "",
    opportunistic: bool = True,
    has_success_today: bool = False,
    cooldown_ok: bool = True,
    cooldown_msg: str = "",
    green_streak: int = 0,
    min_green_streak: int = 1,
    stock_ok: bool = True,
    stock_msg: str = "",
) -> tuple[bool, list[str]]:
    """Pure decision — GREEN only; sheet-driven; daily job caps optional (0=off).

    While pending approved ideas remain: start 1 job when GREEN + idle + budget
    + cooldown. Always requires a fresh classification from this tick's probe.
    """
    reasons: list[str] = []
    cls = (classification or "").upper()
    if cls != "GREEN":
        reasons.append(f"classification={cls or 'None'} (farm green-light only)")
        return False, reasons
    if not auto_start:
        reasons.append("RUNPOD_AUTO_START=0")
        return False, reasons
    if dry_run:
        reasons.append("dry_run — would start if all gates pass")
        return False, reasons
    if not pending_ok:
        reasons.append(pending_msg or "no pending sheet ideas")
        return False, reasons
    # Optional emergency brakes only (0 = DISABLED — sheet-driven default).
    ceiling = hard_cap if hard_cap > 0 else (soft_cap if soft_cap > 0 else 0)
    if ceiling > 0 and auto_starts_today >= ceiling:
        reasons.append(
            f"optional daily job ceiling reached ({auto_starts_today}>={ceiling})"
        )
        return False, reasons
    if not smoke_ok:
        reasons.append(f"smoke gate closed: {smoke_msg}")
        return False, reasons
    if concurrent_busy:
        reasons.append(f"job already running: {concurrent_msg}")
        return False, reasons
    if not budget_ok:
        reasons.append(f"budget blocked: {budget_msg}")
        return False, reasons
    if not cooldown_ok:
        reasons.append(cooldown_msg or "cooldown active")
        return False, reasons
    if green_streak < min_green_streak:
        reasons.append(
            f"need {min_green_streak} consecutive GREEN probes "
            f"(have {green_streak})"
        )
        return False, reasons
    if not stock_ok:
        reasons.append(stock_msg or "Community stock below min")
        return False, reasons

    # Chain after first start requires opportunistic (default on).
    if auto_starts_today > 0 and not opportunistic:
        reasons.append(
            "RUNPOD_AUTO_OPPORTUNISTIC=0 — refusing chain after prior start today"
        )
        return False, reasons

    # Optional ceiling mode: require success before 2nd+ when a ceiling is set.
    if (
        opportunistic
        and auto_starts_today > 0
        and not has_success_today
        and ceiling > 0
    ):
        reasons.append(
            "need a successful job today before next under optional daily ceiling"
        )
        return False, reasons

    label = "sheet-driven" if auto_starts_today <= 0 else "chain"
    return True, [
        f"GREEN {label} start "
        f"(today={auto_starts_today + 1}; caps={'off' if ceiling <= 0 else ceiling}) "
        f"streak={green_streak} {pending_msg} {stock_msg}".strip()
    ]


def _decision_kwargs(
    *,
    classification: str,
    dry_run: bool,
    state: WatchdogState,
    now: datetime,
    smoke_ok: bool,
    smoke_msg: str,
    busy: bool,
    busy_msg: str,
    budget_ok: bool,
    budget_msg: str,
    pending_ok: bool,
    pending_msg: str,
    bench: CapacityBenchmarkResult | None,
) -> dict[str, Any]:
    soft = auto_max_jobs_per_day()
    hard = auto_max_jobs_per_day_hard()
    ok_cd, cd_msg = cooldown_elapsed(state, now=now)
    ok_stock, stock_msg = community_stock_meets_min(bench)
    succ = _parse_ts(state.last_success_ts)
    # Success within last 12h counts for chain (not strict UTC-day).
    has_success = False
    if succ is not None:
        has_success = (now - succ).total_seconds() <= 12 * 3600
    return {
        "classification": classification,
        "auto_start": auto_start_enabled(),
        "dry_run": dry_run,
        "auto_starts_today": state.auto_starts_today,
        "soft_cap": soft,
        "hard_cap": hard,
        "smoke_ok": smoke_ok,
        "smoke_msg": smoke_msg,
        "concurrent_busy": busy,
        "concurrent_msg": busy_msg,
        "budget_ok": budget_ok,
        "budget_msg": budget_msg,
        "pending_ok": pending_ok,
        "pending_msg": pending_msg,
        "opportunistic": opportunistic_enabled(),
        "has_success_today": has_success,
        "cooldown_ok": ok_cd,
        "cooldown_msg": cd_msg,
        "green_streak": state.green_streak,
        "min_green_streak": opportunistic_min_green_streak(),
        "stock_ok": ok_stock,
        "stock_msg": stock_msg,
    }


def _start_one_visuals_job() -> tuple[bool, str | None, list[dict[str, Any]], str]:
    """Phase B: resume oldest ready_for_stills job (GREEN-gated via spawn)."""
    from src.agents.farm import list_ready_for_stills, spawn_farm_job, voice_artifacts_ready

    ready = list_ready_for_stills()
    if not ready:
        return False, None, [], "no ready_for_stills jobs"
    job = ready[0]
    if not voice_artifacts_ready(job.job_dir):
        return (
            False,
            job.id,
            [],
            f"ready_for_stills job {job.id} missing script/voice artifacts",
        )
    spawned = spawn_farm_job(job.id, phase="visuals")
    results = [{"job_id": job.id, "pipeline": spawned, "farm_phase": "visuals"}]
    if not spawned.get("ok"):
        return False, job.id, results, str(spawned.get("error") or "visuals spawn failed")
    if spawned.get("already_running"):
        return False, job.id, results, f"job {job.id} already running"
    if spawned.get("spawned"):
        return True, job.id, results, f"started visuals job_id={job.id}"
    return False, job.id, results, f"visuals spawn no-op for {job.id}"


def _start_one_farm_job() -> tuple[bool, str | None, list[dict[str, Any]], str]:
    """Call the same pick_and_enqueue path as production (max 1).

    Prefers Phase B (parked voice) when available; else full pipeline pick.
    """
    from src.agents.farm import count_ready_for_stills
    from src.agents.title_queue import TitleQueue
    from src.agents.worker import pick_and_enqueue

    voice_n = count_ready_for_stills()
    if voice_n > 0:
        return _start_one_visuals_job()

    inv = TitleQueue().inventory_approved()
    for r in inv["skipped_have_job_id"]:
        logger.info(
            "watchdog SKIP have_job_id channel=%s row=%s job_id=%s title=%r",
            r.channel,
            r.row_index,
            r.job_id,
            r.title,
        )
    for r in inv["ready"][:12]:
        logger.info(
            "watchdog READY empty_job_id channel=%s row=%s title=%r",
            r.channel,
            r.row_index,
            r.title,
        )
    logger.info(
        "watchdog pick inventory ready=%d skipped_have_job_id=%d",
        len(inv["ready"]),
        len(inv["skipped_have_job_id"]),
    )

    results = pick_and_enqueue(limit=1, enqueue_pipeline=True, max_concurrent=1)
    if not results:
        return False, None, results, "pick returned empty (no approved titles?)"
    first = results[0]
    if first.get("error"):
        return False, None, results, str(first.get("error"))
    job_id = first.get("job_id")
    pipe = first.get("pipeline") or {}
    if isinstance(pipe, dict) and pipe.get("ok") is False:
        return False, job_id, results, str(pipe.get("error") or "spawn failed")
    status = str(first.get("status") or "")
    if status in {
        "already_enqueued",
        "already_published",
        "already_done",
        "blocked_failed_hold",
        "skip_has_job_id",
        "hold",
        "deferred",
    }:
        return False, job_id, results, f"pick status={status}: {first.get('note') or first.get('error') or ''}"
    if job_id:
        return True, str(job_id), results, f"started job_id={job_id}"
    return False, None, results, "pick completed without job_id"


def _maybe_prep_voice(
    *,
    dry_run: bool = False,
    force: bool = False,
    limit: int | None = None,
) -> dict[str, Any] | None:
    """Phase A: bank script+TTS for approved sheet jobs (no RunPod).

    Runs on RED/YELLOW and when GREEN did not start GPU work. Pre-window /
    buffer-deficit ticks prep more aggressively so prime GPU time only burns
    stills on already voice-ready jobs.
    """
    if not prep_voice_enabled() or prep_voice_max() <= 0:
        return {"skipped": True, "reason": "prep_voice disabled"}
    if dry_run:
        return {"skipped": True, "reason": "dry_run"}
    try:
        from src.agents.farm import (
            count_prep_jobs,
            count_ready_for_stills,
            prep_slot_available,
        )
        from src.agents.worker import prep_voice_jobs

        ready_n = count_ready_for_stills()
        cap = prep_voice_max()
        if ready_n >= cap and not force:
            return {
                "skipped": True,
                "reason": "prep buffer full",
                "ready_for_stills": ready_n,
                "cap": cap,
            }
        ok_prep, prep_msg = prep_slot_available()
        if not ok_prep:
            return {
                "skipped": True,
                "reason": prep_msg,
                "prep": count_prep_jobs(),
                "ready_for_stills": ready_n,
            }
        # Bank toward SLA: prep up to remaining slots (cap at 2 per tick).
        remain = max(1, cap - ready_n)
        tick_limit = int(limit) if limit is not None else (2 if force else 1)
        tick_limit = max(1, min(tick_limit, remain, 2))
        results = prep_voice_jobs(limit=tick_limit, max_ready=cap)
        return {
            "results": results,
            "ready_for_stills": count_ready_for_stills(),
            "prep": count_prep_jobs(),
            "cap": cap,
            "forced": bool(force),
            "tick_limit": tick_limit,
        }
    except Exception as exc:  # noqa: BLE001
        logger.warning("watchdog prep_voice failed: %s", exc)
        return {"error": str(exc)[:300]}



def run_watchdog_tick(
    *,
    dry_run: bool = False,
    force_probe: bool = False,
    skip_learn: bool = False,
    skip_harvest: bool = False,
    client: Any = None,
    now: datetime | None = None,
    state_path: Path | None = None,
    rng: random.Random | None = None,
) -> WatchdogTickResult:
    """One cron tick: maybe probe, learn, harvest refill, GREEN-only auto-start."""
    now = now or datetime.now(timezone.utc)

    # Two-lane board + gpu_ready sheet sync + approvals digest (every beat)
    two_lane_payload: dict[str, Any] | None = None
    try:
        two_lane_payload = two_lane.run_two_lane_tick(dry_run=dry_run)
    except Exception as exc:  # noqa: BLE001
        logger.warning("two_lane tick failed: %s", exc)
        two_lane_payload = {"error": str(exc)[:300]}

    if now.tzinfo is None:
        now = now.replace(tzinfo=timezone.utc)
    else:
        now = now.astimezone(timezone.utc)

    state = _roll_daily_counter(WatchdogState.load(state_path), now)
    in_window, window_label, schedule_advice = evaluate_schedule(now=now)

    if not watchdog_enabled() and not force_probe:
        finance_payload = _maybe_finance_recheck(dry_run=dry_run)
        smm_payload = _maybe_smm_scan(dry_run=dry_run)
        result = WatchdogTickResult(
            at=utcnow_iso(),
            action="disabled",
            probed=False,
            in_window=in_window,
            message="RUNPOD_WATCHDOG=0",
            dry_run=dry_run,
            finance=finance_payload,
            smm=smm_payload,
            reasons=["watchdog disabled"],
            state=asdict(state),
        )
        _write_last(result)
        return result

    # Idea-stock refill (publish on OR ≥1 public-path title; stock < ~15/sheet)
    harvest_payload: dict[str, Any] | None = None
    if not skip_harvest:
        try:
            from src.agents.idea_stock import maybe_refill_idea_stock

            # Pre-window / buffer SLA: force harvest so GREEN rarely meets empty sheet.
            _pending_preview = 0
            try:
                _pending_preview = _pending_ideas_ok()[2]
            except Exception:  # noqa: BLE001
                pass
            _voice_preview = 0
            try:
                from src.agents.farm import count_ready_for_stills as _crs

                _voice_preview = _crs()
            except Exception:  # noqa: BLE001
                pass
            _pre = ops_ready.in_pre_window_refill(now)
            _buf_def = max(
                0,
                ops_ready.queue_buffer_target() - (int(_pending_preview) + int(_voice_preview)),
            )
            force_harvest = bool(_pre.get("active")) or _buf_def > 0
            harvest_payload = maybe_refill_idea_stock(
                dry_run=dry_run, force=force_harvest
            )
            if isinstance(harvest_payload, dict):
                harvest_payload["force"] = force_harvest
                harvest_payload["pre_window"] = _pre
                harvest_payload["buffer_deficit_preview"] = _buf_def
        except Exception as exc:  # noqa: BLE001
            harvest_payload = {"error": str(exc)[:300]}
            logger.warning("watchdog harvest refill failed: %s", exc)

    # Transient prep/script JSON failures — requeue same job_id (no remake).
    repair_payload = _maybe_repair_script_json(dry_run=dry_run)
    smm_payload = _maybe_smm_scan(dry_run=dry_run)

    due, due_reason = probe_is_due(state, now=now, force=force_probe)
    if not due:
        chain_due, chain_reason = chain_reprobe_due(state, now=now)
        if chain_due:
            due, due_reason = True, chain_reason
    if not due:
        pending_ok, pending_msg, pending_n = _pending_ideas_ok()
        voice_ready = 0
        try:
            from src.agents.farm import count_ready_for_stills

            voice_ready = count_ready_for_stills()
        except Exception:  # noqa: BLE001
            pass
        prep_payload = _maybe_prep_voice(dry_run=dry_run)
        prep_started = False
        prep_job_id = None
        if isinstance(prep_payload, dict):
            for item in prep_payload.get("results") or []:
                pipe = item.get("pipeline") or {}
                if pipe.get("spawned") and pipe.get("job_id"):
                    prep_started = True
                    prep_job_id = pipe.get("job_id")
                    break
        finance_payload = _maybe_finance_recheck(dry_run=dry_run)
        result = WatchdogTickResult(
            at=utcnow_iso(),
            action="prepped_voice" if prep_started else "skip_probe_not_due",
            probed=False,
            in_window=in_window,
            message=(
                f"prep spawned job={prep_job_id}"
                if prep_started
                else due_reason
            ),
            dry_run=dry_run,
            classification=state.last_classification,
            decision=state.last_decision,
            harvest=harvest_payload,
            prep=prep_payload,
            finance=finance_payload,
            smm=smm_payload,
            repair=repair_payload,
            pending_ready=pending_n,
            voice_ready=voice_ready,
            job_id=str(prep_job_id) if prep_job_id else None,
            started=False,  # CPU Phase A — not a GREEN GPU start
            reasons=[
                due_reason,
                schedule_advice if not in_window else f"in {window_label}",
                pending_msg,
                f"voice_ready={voice_ready}",
            ],
            state=asdict(state),
        )
        state.last_action = result.action
        state.save(state_path)
        _write_last(result)
        return result

    # --- Probe (GraphQL only; no pod create) ---
    ok_green, green_msg, bench = check_farm_capacity_green(
        client=client, log_jsonl=True
    )
    if bench is None:
        bench = run_capacity_benchmark(client=client, allow_secure_flag=False)

    assert isinstance(bench, CapacityBenchmarkResult)
    classification = bench.classification
    decision = bench.decision

    if classification == "GREEN":
        state.green_streak = int(state.green_streak or 0) + 1
    else:
        state.green_streak = 0

    state.last_probe_ts = utcnow_iso()
    state.next_probe_ts = compute_next_probe_at(
        now=now, in_window=in_window, rng=rng
    ).isoformat()
    state.last_classification = classification
    state.last_decision = decision

    learn_payload: dict[str, Any] | None = None
    if not skip_learn:
        try:
            learn_payload = recompute_availability_learn(now=now)
        except Exception as exc:  # noqa: BLE001
            learn_payload = {"error": str(exc)[:300]}
            logger.warning("watchdog learn failed: %s", exc)

    smoke_ok, smoke_msg = _smoke_gate_ok()
    busy, busy_msg = _concurrent_busy()
    budget_ok, budget_msg = _budget_ok()
    pending_ok, pending_msg, pending_n = _pending_ideas_ok()
    voice_ready = 0
    try:
        from src.agents.farm import count_ready_for_stills

        voice_ready = count_ready_for_stills()
    except Exception:  # noqa: BLE001
        pass
    # GREEN may start Phase B even when no new sheet ideas remain.
    pending_ok_for_start = pending_ok or voice_ready > 0
    pending_msg_for_start = (
        pending_msg
        if pending_ok
        else (f"voice_ready={voice_ready}" if voice_ready > 0 else pending_msg)
    )

    decide_kw = _decision_kwargs(
        classification=classification,
        dry_run=dry_run,
        state=state,
        now=now,
        smoke_ok=smoke_ok,
        smoke_msg=smoke_msg,
        busy=busy,
        busy_msg=busy_msg,
        budget_ok=budget_ok,
        budget_msg=budget_msg,
        pending_ok=pending_ok_for_start,
        pending_msg=pending_msg_for_start,
        bench=bench,
    )
    should_start, reasons = decide_auto_start(**decide_kw)

    started = False
    job_id: str | None = None
    pick: list[dict[str, Any]] = []
    action: WatchdogAction = "probed_no_start"
    message = green_msg
    prep_payload: dict[str, Any] | None = None

    if dry_run:
        action = "dry_run"
        live_kw = dict(decide_kw)
        live_kw["dry_run"] = False
        would, would_reasons = decide_auto_start(**live_kw)
        reasons = [f"dry_run probe done; would_start={would}"] + would_reasons
        message = (
            f"DRY-RUN {classification}: would_start={would}. {bench.message}"
        )
    elif should_start:
        if classification != "GREEN":
            action = "blocked"
            reasons.append("refusing start — not GREEN")
            message = f"blocked: {classification}"
        else:
            started, job_id, pick, start_msg = _start_one_farm_job()
            reasons.append(start_msg)
            if started:
                action = "started_job"
                state.auto_starts_today += 1
                state.last_job_id = job_id
                state.last_start_ts = now.isoformat()
                phase_note = (
                    "visuals"
                    if any(
                        (p or {}).get("farm_phase") == "visuals"
                        for p in pick
                        if isinstance(p, dict)
                    )
                    else "full"
                )
                message = (
                    f"AUTO-START GREEN {phase_note} job={job_id} "
                    f"(today={state.auto_starts_today}; pending was {pending_n}; "
                    f"voice_ready was {voice_ready})"
                )
            else:
                action = "probed_no_start"
                message = f"GREEN but start skipped: {start_msg}"
    else:
        if classification in {"YELLOW", "RED"}:
            action = "blocked"
            message = (
                f"FARM BLOCKED green-light only — {classification}. "
                f"{bench.message}"
            )
        elif not pending_ok_for_start:
            action = "probed_no_start"
            message = (
                f"{classification}: probe+learn ok; no production — {pending_msg}"
            )
        else:
            action = "probed_no_start"
            message = f"{classification}: not starting — {'; '.join(reasons)}"

    # Phase A: bank script+TTS when GPU path did not take the slot.
    # Pre-window + buffer deficit → prep harder (CTO: non-GPU work off prime time).
    if not dry_run and not started:
        _pre2 = ops_ready.in_pre_window_refill(now)
        _buf2 = max(
            0,
            ops_ready.queue_buffer_target() - (int(pending_n) + int(voice_ready)),
        )
        prep_payload = _maybe_prep_voice(
            dry_run=False,
            force=bool(_pre2.get("active")) or _buf2 > 0,
            limit=2 if (bool(_pre2.get("active")) or _buf2 > 0) else 1,
        )
        if isinstance(prep_payload, dict):
            for item in prep_payload.get("results") or []:
                pipe = item.get("pipeline") or {}
                if pipe.get("spawned") and pipe.get("job_id"):
                    if action in {"blocked", "probed_no_start"}:
                        action = "prepped_voice"
                        job_id = str(pipe.get("job_id"))
                        message = (
                            f"Phase A prep spawned job={job_id} "
                            f"(class={classification}; GPU blocked/idle)"
                        )
                        reasons.append(f"prepped_voice job_id={job_id}")
                    break
        try:
            from src.agents.farm import count_ready_for_stills

            voice_ready = count_ready_for_stills()
        except Exception:  # noqa: BLE001
            pass

    state.last_action = action
    state.save(state_path)

    finance_payload = _maybe_finance_recheck(dry_run=dry_run)
    result = WatchdogTickResult(
        at=utcnow_iso(),
        action=action,
        probed=True,
        in_window=in_window,
        classification=classification,
        decision=decision,
        message=message,
        started=started,
        dry_run=dry_run,
        job_id=job_id,
        pick=pick,
        harvest=harvest_payload,
        prep=prep_payload,
        finance=finance_payload,
        smm=smm_payload,
        repair=repair_payload,
        pending_ready=pending_n,
        voice_ready=voice_ready,
        learn={
            "sample_count": (learn_payload or {}).get("sample_count"),
            "enough_samples": (learn_payload or {}).get("enough_samples"),
            "promotable": (learn_payload or {}).get("promotable"),
            "chosen_scope": (learn_payload or {}).get("chosen_scope"),
            "suggested_primary_window_utc": (learn_payload or {}).get(
                "suggested_primary_window_utc"
            ),
            "suggested_backup_window_utc": (learn_payload or {}).get(
                "suggested_backup_window_utc"
            ),
            "exploratory_primary_window_utc": (learn_payload or {}).get(
                "exploratory_primary_window_utc"
            ),
            "windows_applied_to_schedule": (learn_payload or {}).get(
                "windows_applied_to_schedule"
            ),
            "maturity_gates": (learn_payload or {}).get("maturity_gates"),
            "error": (learn_payload or {}).get("error"),
        }
        if learn_payload is not None
        else None,
        state=asdict(state),
        reasons=reasons,
    )
    _write_last(result)

    miss_code = ops_ready.classify_green_no_start(
        classification=result.classification,
        started=result.started,
        pending_ready=int(result.pending_ready or 0),
        voice_ready=int(result.voice_ready or 0),
        busy=busy,
        reasons=list(result.reasons or []),
        message=result.message or "",
    )
    state.empty_sheet_miss_streak = ops_ready.update_empty_sheet_streak(
        state.empty_sheet_miss_streak, miss_code
    )
    state.save(state_path)
    ops_snap = ops_ready.ops_readiness_snapshot(
        pending_ready=int(result.pending_ready or 0),
        voice_ready=int(result.voice_ready or 0),
        classification=result.classification,
        in_window=bool(result.in_window),
        job_inflight=busy,
        pre_window=ops_ready.in_pre_window_refill(now),
        miss_code=miss_code,
        empty_sheet_miss_streak=state.empty_sheet_miss_streak,
    )
    ops_ready.record_green_opportunity(
        miss_code=miss_code,
        result_payload=result.to_dict(),
        window_label=window_label,
        busy=busy,
        busy_msg=busy_msg,
        ops=ops_snap,
    )
    if miss_code == ops_ready.MISS_EMPTY_SHEET:
        ops_ready.maybe_alert_empty_sheet_streak(
            streak=state.empty_sheet_miss_streak, ops=ops_snap
        )

    logger.info(
        "watchdog tick action=%s class=%s started=%s dry_run=%s "
        "pending=%s voice_ready=%s streak=%s",
        action,
        classification,
        started,
        dry_run,
        pending_n,
        voice_ready,
        state.green_streak,
    )
    if isinstance(two_lane_payload, dict) and not two_lane_payload.get("error"):
        logger.info(
            "two_lane board CPU_PREP=%s GPU_READY=%s GPU_RENDER=%s approvals_needed=%s",
            (two_lane_payload.get("lanes") or {}).get("CPU_PREP"),
            (two_lane_payload.get("lanes") or {}).get("GPU_READY"),
            (two_lane_payload.get("lanes") or {}).get("GPU_RENDER"),
            two_lane_payload.get("approvals_needed"),
        )
        # Stash on last tick JSON for operators
        try:
            d = result.to_dict()
            d["two_lane"] = {
                "lanes": two_lane_payload.get("lanes"),
                "buffer": two_lane_payload.get("buffer"),
                "approvals_needed": two_lane_payload.get("approvals_needed"),
                "digest_md": two_lane_payload.get("digest_md"),
            }
            LAST_TICK_PATH.write_text(
                json.dumps(d, indent=2, ensure_ascii=False) + "\n",
                encoding="utf-8",
            )
        except Exception:  # noqa: BLE001
            pass
    return result



def _maybe_smm_scan(*, dry_run: bool = False) -> dict[str, Any] | list[dict[str, Any]] | None:
    """SMM beat on */10 watchdog: observe+pin+winner learn; soft packaging if armed.

    Quota coalesce (~10m) lives in SocialMediaManager.scan_and_act so */10 + */15
    sleep_factory do not double-spend YouTube quota. Winner learn also gated by
    winner_refresh_hours; non-public skipped. Never blocks GPU / prep / harvest.
    Persists result on runpod_watchdog_last.json as ``smm``.
    """
    if dry_run:
        return {"skipped": True, "reason": "dry_run"}
    try:
        from src.agents.smm_agent import SocialMediaManager

        results = SocialMediaManager().scan_and_act()
        n = len(results) if isinstance(results, list) else 0
        acted = 0
        skipped = 0
        errors = 0
        if isinstance(results, list):
            for item in results:
                if not isinstance(item, dict):
                    continue
                if item.get("error") or item.get("ok") is False:
                    errors += 1
                elif item.get("skipped"):
                    skipped += 1
                elif (
                    item.get("actions")
                    or item.get("promoted_to_public")
                    or item.get("channel_winners")
                ):
                    acted += 1
                else:
                    skipped += 1
        coalesce = False
        if isinstance(results, list) and results:
            head = results[0] if isinstance(results[0], dict) else {}
            if head.get("reason") == "quota_coalesce":
                coalesce = True
        return {
            "ok": True,
            "jobs_touched": n,
            "acted": acted,
            "skipped": skipped,
            "errors": errors,
            "quota_coalesce": coalesce,
            "results": results if n <= 12 else (results[:12] if isinstance(results, list) else results),
        }
    except Exception as exc:  # noqa: BLE001
        logger.warning("watchdog smm scan failed: %s", exc)
        return {"ok": False, "error": str(exc)[:300]}


