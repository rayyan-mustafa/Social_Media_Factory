def auto_max_jobs_per_day() -> int:
    """Optional emergency soft daily job-count brake. **0 = DISABLED** (default).

    Sheet-driven production: no daily job count caps. CostGuardian still applies.
    """
    if "RUNPOD_AUTO_MAX_JOBS_PER_DAY" in os.environ:
        return max(0, _env_int("RUNPOD_AUTO_MAX_JOBS_PER_DAY", 0))
    s = _settings()
    if s is not None:
        return max(0, int(getattr(s, "runpod_auto_max_jobs_per_day", 0) or 0))
    return 0


def auto_max_jobs_per_day_hard() -> int:
    """Optional emergency hard daily job-count brake. **0 = DISABLED** (default).

    When both soft and hard are 0, daily job counts never block auto-start.
    If either is set >0, that positive value acts as a ceiling (hard ≥ soft).
    """
    soft = auto_max_jobs_per_day()
    if "RUNPOD_AUTO_MAX_JOBS_PER_DAY_HARD" in os.environ:
        hard = max(0, _env_int("RUNPOD_AUTO_MAX_JOBS_PER_DAY_HARD", 0))
    else:
        s = _settings()
        hard = (
            max(0, int(getattr(s, "runpod_auto_max_jobs_per_day_hard", 0) or 0))
            if s is not None
            else 0
        )
    if soft <= 0 and hard <= 0:
        return 0  # both disabled
    if hard <= 0:
        return soft  # only soft set → use as ceiling
    return max(soft, hard)


def daily_job_caps_disabled() -> bool:
    return auto_max_jobs_per_day_hard() <= 0


