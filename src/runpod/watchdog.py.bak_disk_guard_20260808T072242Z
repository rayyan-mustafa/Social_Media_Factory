def expected_probes_per_day() -> dict[str, Any]:
    """Documented estimate for ops (GraphQL only — $0, no pods)."""
    in_m = probe_interval_in_window_min()
    out_base = probe_interval_out_window_min()
    # With */10 cadence ~144 probes/day if always due; still $0 GraphQL.
    in_hours = 7.0
    out_hours = 17.0
    in_probes = in_hours * (60.0 / in_m)
    out_probes = out_hours * (60.0 / out_base)
    return {
        "in_window_interval_min": in_m,
        "out_window_interval_min_nominal": out_base,
        "out_window_range_min": [
            max(1, out_base - probe_out_window_jitter_min()),
            out_base + probe_out_window_jitter_min(),
        ],
        "assumed_window_hours_per_day": in_hours,
        "assumed_out_hours_per_day": out_hours,
        "est_probes_in_window": round(in_probes, 1),
        "est_probes_out_window": round(out_probes, 1),
        "est_probes_per_day_total": round(in_probes + out_probes, 1),
        "cron_recommended": "*/10",
        "note": (
            "Probes are GraphQL stock checks only (no pod create). "
            "Daily job-count caps DISABLED; CostGuardian $ ceilings limit spend. "
            "Sheet approved=TRUE ideas gate production."
        ),
        "daily_job_caps_disabled": daily_job_caps_disabled(),
        "soft_jobs_per_day": auto_max_jobs_per_day(),
        "hard_jobs_per_day": auto_max_jobs_per_day_hard(),
        "opportunistic": opportunistic_enabled(),
        "job_cooldown_min": job_cooldown_min(),
    }


@dataclass
class WatchdogState:
    last_probe_ts: str | None = None
    next_probe_ts: str | None = None
    auto_starts_utc_date: str = ""
    auto_starts_today: int = 0
    last_classification: str | None = None
    last_decision: str | None = None
    last_action: str | None = None
    last_job_id: str | None = None
    last_start_ts: str | None = None
    last_success_job_id: str | None = None
    last_success_ts: str | None = None
    green_streak: int = 0
    empty_sheet_miss_streak: int = 0
    updated_at_utc: str | None = None

    @classmethod
    def load(cls, path: Path | None = None) -> WatchdogState:
        src = path or STATE_PATH
        if not src.exists():
            return cls()
        try:
            data = json.loads(src.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return cls()
        if not isinstance(data, dict):
            return cls()
        return cls(
            last_probe_ts=data.get("last_probe_ts"),
            next_probe_ts=data.get("next_probe_ts"),
            auto_starts_utc_date=str(data.get("auto_starts_utc_date") or ""),
            auto_starts_today=int(data.get("auto_starts_today") or 0),
            last_classification=data.get("last_classification"),
            last_decision=data.get("last_decision"),
            last_action=data.get("last_action"),
            last_job_id=data.get("last_job_id"),
            last_start_ts=data.get("last_start_ts"),
            last_success_job_id=data.get("last_success_job_id"),
            last_success_ts=data.get("last_success_ts"),
            green_streak=int(data.get("green_streak") or 0),
            empty_sheet_miss_streak=int(data.get("empty_sheet_miss_streak") or 0),
            updated_at_utc=data.get("updated_at_utc"),
        )

    def save(self, path: Path | None = None) -> Path:
        dest = path or STATE_PATH
        dest.parent.mkdir(parents=True, exist_ok=True)
        self.updated_at_utc = utcnow_iso()
        payload = asdict(self)
        with _LOCK:
            dest.write_text(
                json.dumps(payload, indent=2, ensure_ascii=False) + "\n",
                encoding="utf-8",
            )
        return dest


@dataclass
class WatchdogTickResult:
    at: str
    action: WatchdogAction
    probed: bool
    in_window: bool
    classification: str | None = None
    decision: str | None = None
    message: str = ""
    started: bool = False
    dry_run: bool = False
    job_id: str | None = None
    pick: list[dict[str, Any]] = field(default_factory=list)
    learn: dict[str, Any] | None = None
    harvest: dict[str, Any] | None = None
    prep: dict[str, Any] | list[dict[str, Any]] | None = None
    finance: dict[str, Any] | None = None
    repair: dict[str, Any] | list[dict[str, Any]] | None = None
    smm: dict[str, Any] | list[dict[str, Any]] | None = None
    pending_ready: int = 0
    voice_ready: int = 0
    state: dict[str, Any] = field(default_factory=dict)
    reasons: list[str] = field(default_factory=list)

    def to_dict(self) -> dict[str, Any]:
        return asdict(self)


def _parse_ts(raw: str | None) -> datetime | None:
    if not raw:
        return None
    try:
        dt = datetime.fromisoformat(str(raw).replace("Z", "+00:00"))
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


def _utc_date(now: datetime) -> str:
    return now.astimezone(timezone.utc).strftime("%Y-%m-%d")


def _roll_daily_counter(state: WatchdogState, now: datetime) -> WatchdogState:
    today = _utc_date(now)
    if state.auto_starts_utc_date != today:
        state.auto_starts_utc_date = today
        state.auto_starts_today = 0
        # Keep last_success for chain across midnight if recent (decide uses 12h window).
    return state


def compute_next_probe_at(
    *,
    now: datetime,
    in_window: bool,
    rng: random.Random | None = None,
) -> datetime:
    """Schedule next probe: dense in-window, jittered out-of-window."""
    rng = rng or random.Random()
    if in_window:
        delta = timedelta(minutes=probe_interval_in_window_min())
    else:
        base = probe_interval_out_window_min()
        jitter = probe_out_window_jitter_min()
        lo = max(1, base - jitter)
        hi = max(lo, base + jitter)
        delta = timedelta(minutes=rng.randint(lo, hi))
    return now + delta


def probe_is_due(
    state: WatchdogState,
    *,
    now: datetime | None = None,
    force: bool = False,
) -> tuple[bool, str]:
    if force:
        return True, "force_probe"
    now = now or datetime.now(timezone.utc)
    next_at = _parse_ts(state.next_probe_ts)
    if next_at is None:
        return True, "no_next_probe_scheduled"
    if now >= next_at:
        return True, f"next_probe_due ({state.next_probe_ts})"
    return False, f"probe_not_due until {state.next_probe_ts}"


def cooldown_elapsed(
    state: WatchdogState,
    *,
    now: datetime,
    cooldown_minutes: int | None = None,
) -> tuple[bool, str]:
    cd = job_cooldown_min() if cooldown_minutes is None else cooldown_minutes
    if cd <= 0:
        return True, "cooldown disabled"
    last = _parse_ts(state.last_start_ts)
    if last is None:
        return True, "no prior start"
    ready_at = last + timedelta(minutes=cd)
    if now >= ready_at:
        return True, f"cooldown ok (≥{cd}m since last start)"
    remain = int((ready_at - now).total_seconds() // 60) + 1
    return False, f"cooldown {remain}m left (need {cd}m between jobs)"


def chain_reprobe_due(
    state: WatchdogState,
    *,
    now: datetime,
) -> tuple[bool, str]:
    """After a success, don't idle — re-probe ASAP once cooldown elapsed."""
    if not opportunistic_enabled():
        return False, "chain after success off (RUNPOD_AUTO_OPPORTUNISTIC=0)"
    hard = auto_max_jobs_per_day_hard()
    if hard > 0 and state.auto_starts_today >= hard:
        return False, f"optional hard daily cap reached ({hard})"
    if not state.last_success_ts:
        return False, "no recent success"
    succ = _parse_ts(state.last_success_ts)
    if succ is None:
        return False, "invalid success ts"
    # Allow chain across UTC midnight if success was recent (within 12h).
    age_h = (now - succ).total_seconds() / 3600.0
    if age_h > 12:
        return False, "success too old for chain wake"
    ok_cd, cd_msg = cooldown_elapsed(state, now=now)
    if not ok_cd:
        return False, cd_msg
    return True, "post-success chain window — re-probe for next job"


# Back-compat alias
opportunistic_reprobe_due = chain_reprobe_due


def best_community_stock(bench: CapacityBenchmarkResult | None) -> str | None:
    """Best Community stockStatus among available levels (HIGH/MEDIUM/LOW)."""
    if bench is None:
        return None
    best: str | None = None
    best_rank = -1
    for lv in bench.levels or []:
        cloud = str(getattr(lv, "cloud_type", "") or "").upper()
        if cloud != "COMMUNITY":
            continue
        if not getattr(lv, "available", False):
            continue
        status = str(getattr(lv, "stock_status", "") or "").strip().upper()
        rank = _STOCK_RANK.get(status, 0)
        if rank > best_rank:
            best_rank = rank
            best = status
    return best


def community_stock_meets_min(
    bench: CapacityBenchmarkResult | None,
    *,
    min_stock: str | None = None,
) -> tuple[bool, str]:
    need = (min_stock or opportunistic_min_stock()).upper()
    need_rank = _STOCK_RANK.get(need, 1)
    best = best_community_stock(bench)
    if best is None:
        return False, "no Community stock available"
    if _STOCK_RANK.get(best, 0) >= need_rank:
        return True, f"Community stock={best} (≥{need})"
    return False, f"Community stock={best} below min {need}"


def notify_farm_success(
    job_id: str,
    *,
    state_path: Path | None = None,
    now: datetime | None = None,
) -> WatchdogState:
    """Called when a farm job finishes successfully — unlocks next-job chain.

    Schedules an early re-probe after cooldown so we start ASAP if still GREEN.
    """
    now = now or datetime.now(timezone.utc)
    if now.tzinfo is None:
        now = now.replace(tzinfo=timezone.utc)
    else:
        now = now.astimezone(timezone.utc)
    state = _roll_daily_counter(WatchdogState.load(state_path), now)
    state.last_success_job_id = job_id
    state.last_success_ts = now.isoformat()
    # Wake soon after cooldown for next job (if GREEN + pending ideas).
    wake = now + timedelta(minutes=max(0, job_cooldown_min()) or 1)
    cur_next = _parse_ts(state.next_probe_ts)
    if cur_next is None or wake < cur_next:
        state.next_probe_ts = wake.isoformat()
    state.save(state_path)
    logger.info(
        "watchdog: farm success job=%s — chain wake at %s",
        job_id,
        state.next_probe_ts,
    )
    return state


