def _is_empty_sheet_miss(
    *,
    classification: str | None,
    started: bool,
    pending_ready: int,
    voice_ready: int,
    reasons: list[str] | None,
    message: str = "",
) -> bool:
    """GREEN capacity with proceed intent, but nothing to start from sheet/queue."""
    if started:
        return False
    if (classification or "").upper() != "GREEN":
        return False
    blob = " ".join([message or ""] + [str(r) for r in (reasons or [])]).lower()
    if "no pending sheet ideas" in blob:
        return True
    return pending_ready <= 0 and voice_ready <= 0 and "no pending" in blob


def _record_missed_green_opportunity(
    *,
    result: "WatchdogTickResult",
    busy: bool | None = None,
    busy_msg: str = "",
    window_label: str = "",
) -> dict[str, Any] | None:
    """Append one durable JSONL row for a missed GREEN production opportunity.

    Records when classification is GREEN / decision would proceed, but no farm
    job started because the sheet/queue had no pending approved ideas (and no
    voice-ready Phase B buffer). Does not start jobs — audit only.
    """
    reasons = list(result.reasons or [])
    if not _is_empty_sheet_miss(
        classification=result.classification,
        started=result.started,
        pending_ready=int(result.pending_ready or 0),
        voice_ready=int(result.voice_ready or 0),
        reasons=reasons,
        message=result.message or "",
    ):
        return None

    inflight = bool(busy) if busy is not None else None
    # Prefer explicit busy gate text if present in reasons
    joined = " ".join(reasons).lower()
    if "job already running" in joined or "gpu_lock" in joined or "inflight" in joined:
        inflight = True

    payload: dict[str, Any] = {
        "event": "missed_green_opportunity",
        "ts_utc": result.at or utcnow_iso(),
        "classification": result.classification,
        "decision": result.decision,
        "action": result.action,
        "reason": "no pending sheet ideas (approved=TRUE + queued)",
        "message": (result.message or "")[:300],
        "reasons": reasons[:12],
        "pending_ready": int(result.pending_ready or 0),
        "voice_ready": int(result.voice_ready or 0),
        "in_preferred_window": bool(result.in_window),
        "window_label": window_label or None,
        "job_inflight": inflight,
        "inflight_detail": (busy_msg or None),
        "started": False,
        "dry_run": bool(result.dry_run),
        "green_streak": (result.state or {}).get("green_streak"),
        "last_job_id": (result.state or {}).get("last_job_id"),
        "last_start_ts": (result.state or {}).get("last_start_ts"),
    }
    try:
        MISSED_GREEN_PATH.parent.mkdir(parents=True, exist_ok=True)
        line = json.dumps(payload, ensure_ascii=False) + "\n"
        with _LOCK:
            with MISSED_GREEN_PATH.open("a", encoding="utf-8") as fh:
                fh.write(line)
        logger.info(
            "missed_green_opportunity ts=%s pending=%s voice_ready=%s "
            "in_window=%s inflight=%s action=%s",
            payload["ts_utc"],
            payload["pending_ready"],
            payload["voice_ready"],
            payload["in_preferred_window"],
            payload["job_inflight"],
            payload["action"],
        )
        return payload
    except Exception as exc:  # noqa: BLE001
        logger.warning("failed to record missed_green_opportunity: %s", exc)
        return None


