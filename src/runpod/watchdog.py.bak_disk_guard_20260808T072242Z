def install_crontab_hint() -> str:
    root = str(ROOT)
    # */10 — Rayyan CTO: production gate + harvest check every 10 minutes.
    return (
        f"# RunPod capacity watchdog (GREEN-only GPU; Phase A voice prep; SMM scan; */10)\n"
        f"# Probe + if GREEN → prefer ready_for_stills visuals else full job. "
        f"Prep may overlap 1 GPU job (RUNPOD_PREP_WHILE_GPU; never 2 pods). "
        f"On RED/YELLOW → script+Kokoro prep (no pod). "
        f"Harvest refill ~15/sheet when publish on or ≥1 public-path title.\n"
        f"# 365d ALWAYS-ON: sleep_factory */15 + watchdog */10 (no holiday disarm).\n"
        f"*/10 * * * * cd {root} && {root}/.venv/bin/python -m src.cli.runpod_watchdog "
        f">> {root}/output/ops/runpod_watchdog.log 2>&1\n"
    )


def install_crontab() -> Path:
    """Arm watchdog cron only — does NOT re-enable blind sleep_factory farm."""
    hint_lines = [ln for ln in install_crontab_hint().splitlines() if ln.strip()]
    marker = "src.cli.runpod_watchdog"

    import subprocess

    existing = ""
    try:
        proc = subprocess.run(
            ["crontab", "-l"],
            check=False,
            capture_output=True,
            text=True,
        )
        if proc.returncode == 0:
            existing = proc.stdout or ""
        elif "no crontab" not in (proc.stderr or "").lower():
            raise RuntimeError(proc.stderr or "crontab -l failed")
    except FileNotFoundError as exc:
        raise RuntimeError("crontab binary not available") from exc

    kept = [ln for ln in existing.splitlines() if marker not in ln]
    # 365d always-on: preserve live sleep_factory lines; never auto-disarm them.
    while kept and not kept[-1].strip():
        kept.pop()
    # ensure sleep_factory beat armed
    sf_marker = "sleep_factory beat"
    has_sf = any(sf_marker in ln and not ln.strip().startswith("#") for ln in kept)
    sf_line = (
        f"*/15 * * * * cd {ROOT} && {ROOT}/.venv/bin/python -m src.cli.sleep_factory beat "
        f">> {ROOT}/output/ops/sleep_factory.log 2>&1"
    )
    extra = [] if has_sf else [sf_line]
    new_lines = kept + ([""] if kept else []) + extra + hint_lines + [""]
    payload = "\n".join(new_lines)
    proc = subprocess.run(
        ["crontab", "-"],
        input=payload,
        check=False,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr or "crontab install failed")
    out_path = ROOT / "output" / "ops" / "crontab_runpod_watchdog.txt"
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(payload, encoding="utf-8")
    return out_path
