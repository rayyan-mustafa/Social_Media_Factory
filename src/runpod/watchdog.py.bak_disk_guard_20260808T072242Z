def _concurrent_busy() -> tuple[bool, str]:
    """GPU lock only — prep jobs must not block GREEN visuals starts."""
    try:
        from src.agents.farm import count_gpu_jobs, count_inflight_jobs, max_gpu_concurrent

        gpu_n = count_gpu_jobs()
        inflight = count_inflight_jobs()
        max_g = max_gpu_concurrent()
